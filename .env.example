# Copy this file to ".env.local" (or add these in Vercel → Settings → Environment Variables).
# Never commit real values. Leave everything empty during development:
# the site then uses a built-in local database (.data/) with demo profiles.

# ---- Launch switch -----------------------------------------------------------
# false (default): hidden from Google (noindex), «تجريبي» badge, demo profiles shown.
# true: indexable, no badge, demo profiles hidden. Redeploy after changing it.
SITE_LIVE=false

# The public address, no trailing slash. Change it after buying a domain, then redeploy.
NEXT_PUBLIC_SITE_URL=https://example.com

# ---- Database (Supabase) — SECRET, server only ---------------------------------
DATABASE_URL=

# ---- Admin login (Supabase Auth, email link) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRET, server only. Used to create login accounts for allowlisted admins
# (public sign-up stays OFF in Supabase). Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
# The first time this email signs in, it becomes the owner.
ADMIN_OWNER_EMAIL=

# ---- Protection & privacy ----------------------------------------------------------
# SECRET. Any long random text; used to hash visitor IPs for rate limiting.
RATE_LIMIT_SECRET=
# Days to keep personal details of closed correction requests. Leave empty until the lawyer decides.
CORRECTION_RETENTION_DAYS=

# ---- Optional -------------------------------------------------------------------
# 1 = add the fictional demo profiles to a real (Supabase) database, e.g. for a preview.
PANAX_SEED_DEMO=
# Local computer only: no-password admin login for building and testing.
# Ignored automatically whenever Supabase, DATABASE_URL or Vercel is present.
ADMIN_DEV_LOGIN=
