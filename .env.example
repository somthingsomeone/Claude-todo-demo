# Copy this file to ".env.local" and fill in values. Never commit real values.
# Leave everything empty during development: the site uses a built-in local database (.data/).

# Supabase database connection string (server-only, keep secret)
DATABASE_URL=

# Supabase project settings (for admin email-link logins)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email of the first owner. The first time this email signs in, it becomes the owner.
ADMIN_OWNER_EMAIL=

# How many days to keep personal details of closed correction requests.
# Leave empty until the lawyer decides.
CORRECTION_RETENTION_DAYS=

# Set to 1 to add the fictional demo profiles to a real (Supabase) database, e.g. for a preview.
PANAX_SEED_DEMO=

# Local computer only: no-password admin login for building and testing.
# Ignored automatically whenever Supabase, DATABASE_URL or Vercel is present.
ADMIN_DEV_LOGIN=
